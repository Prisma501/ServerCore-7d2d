using AllocsFixes.PersistentData;
using System;

namespace CSMM_Patrons
{
	public class ChatFilter
	{
        
        public static bool Exec (ClientInfo _cInfo, EChatType _type, string _message, string _playerName)
		{
			if (!string.IsNullOrEmpty (_message)) {
				if (_cInfo != null) {
					Player p = PersistentContainer.Instance.Players [_cInfo.playerId, false];
                    string message = _message.Trim().ToLower();

                    if (p != null) {
                        string chatName = string.Empty;
                        string pf = PersistentData.PersistentContainer.Instance.Chatgroups.Prefix;
                        if (string.IsNullOrEmpty(pf))
                            pf = "/";

                        if (message.StartsWith(pf + "ls"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "ls received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            
                            if (message.Equals(pf + "ls"))
                            {
                                _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Check for who???[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                                return false;
                            }
                            else
                            {
                                string parameter = message.Split(new string[] { pf + "ls" }, StringSplitOptions.None)[1].Trim();
                                bool success = seen.Exec(_cInfo, parameter);
                                if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I cant check players last online time.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                                return false;
                            }
                        }

                        if (message.StartsWith(pf + "day7"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "day7 received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /day7");
                            bool success = day7.Exec(_cInfo);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able to get info on day7 hordenight.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        //if (message.StartsWith(pf + "grablcb"))
                        //{
                        //    _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "grablcb received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                        //    //Log.Out("Chatcommand received: '" + p.Name + "': /hostiles");
                        //    bool success = GrabLCB.Exec(_cInfo);
                        //    if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! Could not retrieve (all) of your landclaims.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                        //    return false;
                        //}

                        if (message.StartsWith(pf + "rt"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf +"rt received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /hostiles");
                            bool success = ReturnAdmin.Exec(_cInfo);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able to tp you back to origin.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "hostiles"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "hostiles received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /hostiles");
                            bool success = Hostiles.Exec(_cInfo);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able to do detection on hostiles.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "bag"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "bag received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /hostiles");
                            bool success = Bag.Exec(_cInfo);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able to find your backpack.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "get"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Received Command: " + pf + "get", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            string parameter = message.Split(new string[] { pf + "get" }, StringSplitOptions.None)[1].Trim();
                            bool success = Get.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! Could not get the player.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "tb"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Received Command: " + pf + "tb", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            string parameter = message.Split(new string[] { pf + "tb" }, StringSplitOptions.None)[1].Trim();
                            bool success = Return.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! Could not tp the player to origin.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "bubble"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Received Command: " + pf + "bubble", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            string parameter = message.Split(new string[] { pf + "bubble" }, StringSplitOptions.None)[1].Trim();
                            bool success = Protect.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! Could not activate protective bubble![-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "ftw"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "ftw received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /ftw");
                            string parameter = message.Split(new string[] { pf + "ftw" }, StringSplitOptions.None)[1].Trim();
                            bool success = Flytowp.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! You were not able to fly to waypoint.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "ft"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "ft received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /ft");

                            if (message.Equals(pf + "ft"))
                            {
                                _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Really!? FLy to...eeh...well...space???[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                                return false;
                            }
                            else
                            {
                                string parameter = message.Split(new string[] { pf + "ft" }, StringSplitOptions.None)[1].Trim();
                                bool success = Flyto.Exec(_cInfo, parameter);
                                if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I think your wings are broken.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                                return false;
                            }
                        }

                        if (message.StartsWith(pf + "mvw"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "mvw received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /mvw");
                            string parameter = message.Split(new string[] { pf + "mvw" }, StringSplitOptions.None)[1].Trim();
                            bool success = Movewp.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able to move the player to waypoint.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "mv"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "mv received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /mv");
                            string parameter = message.Split(new string[] { pf + "mv" }, StringSplitOptions.None)[1].Trim();
                            bool success = Move.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! Could not perform the move.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "listwp"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "listwp received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /listwp");
                            bool success = Listwp.Exec(_cInfo);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able get the waypoints.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "setwp"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "setwp received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /setwp");
                            string parameter = message.Split(new string[] { pf + "setwp" }, StringSplitOptions.None)[1].Trim();
                            bool success = Setwp.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able to set the waypoint.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "delwp"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "delwp received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /delwp");
                            string parameter = message.Split(new string[] { pf + "delwp" }, StringSplitOptions.None)[1].Trim();
                            bool success = Delwp.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able to delete the waypoint.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "acf"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "acf received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /acf");
                            string parameter = message.Split(new string[] { pf + "acf" }, StringSplitOptions.None)[1].Trim();
                            bool success = Addclaimfriend.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! Could not add player to claim whitelist.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "rcf"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "rcf received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /rcf");
                            string parameter = message.Split(new string[] { pf + "rcf" }, StringSplitOptions.None)[1].Trim();
                            bool success = Removeclaimfriend.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! Could not remove player from claim whitelist.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(pf + "lcf"))
                        {
                            _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command " + pf + "lcf received", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            //Log.Out("Chatcommand received: '" + p.Name + "': /lcf");
                            string parameter = message.Split(new string[] { pf + "lcf" }, StringSplitOptions.None)[1].Trim();
                            bool success = Listclaimfriends.Exec(_cInfo, parameter);
                            if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! Could not list claim whitelist.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                            return false;
                        }

                        if (message.StartsWith(PersistentData.PersistentContainer.Instance.LocationTracking.Command.Trim().ToLower()))
                        {
                            string command = PersistentData.PersistentContainer.Instance.LocationTracking.Command.Trim().ToLower();
                            if (PersistentData.PersistentContainer.Instance.LocationTracking.CommandEnabled)
                            {
                                _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Received Command: " + command, PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                                string parameter = message.Split(new string[] { command }, StringSplitOptions.None)[1].Trim();
                                bool success = Who.Exec(_cInfo, parameter);
                                if (!success) _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "[FFA07A]Something went wrong! I was not able to check who was here.[-]", PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                                return false;
                            }
                            else
                            {
                                _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, string.Format("[FFA07A]Locationtrack command {0} is not enabled[-]", command), PersistentData.PersistentContainer.Instance.Chatgroups.ServerChatName, false, "", false));
                                return false;
                            }
                        }

                        if (_message.Length > p.MaxChatLength) {
							_cInfo.SendPackage (new NetPackageGameMessage (EnumGameMessages.Chat, "Your message was too long. So we blocked it!", "Server (PM)", false, "", false));
							return false;
						}
						if (p.IsChatMuted) {
							_cInfo.SendPackage (new NetPackageGameMessage (EnumGameMessages.Chat, "Your chat is muted!", "Server (PM)", false, "", false));
							return false;
						}

						//Check its a command
						if (PersistentContainer.Instance.Attributes.HideChatCommands)
                        {
                            if (PersistentContainer.Instance.Attributes.HideChatCommandPrefix.Contains(","))
                            {
                                string[] arrPrefixes = PersistentContainer.Instance.Attributes.HideChatCommandPrefix.Split(',');
                                for(int i=0;i < arrPrefixes.Length;i++)
                                {
                                    if (_message.Trim().StartsWith(arrPrefixes[i]))
                                    {
                                        _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command received " + _message, "Server (PM)", false, "", false));
                                        Log.Out("Chat: '" + p.Name + "': " + _message);
                                        return false;
                                    }
                                }
                            }
                            else
                            {
                                if (_message.Trim().StartsWith(PersistentContainer.Instance.Attributes.HideChatCommandPrefix))
                                {
                                    _cInfo.SendPackage(new NetPackageGameMessage(EnumGameMessages.Chat, "Command received " + _message, "Server (PM)", false, "", false));
                                    Log.Out("Chat: '" + p.Name + "': " + _message);
                                    return false;
                                }
                            }
                        }

                        //groupChat coloring
                        string group = PersistentData.PersistentContainer.Instance.Players[_cInfo.playerId, true].MemberOfGroup;
                        if (!string.IsNullOrEmpty(group))
                        {
                            if (PersistentData.PersistentContainer.Instance.Chatgroups.GroupExists(group))
                            {
                                string groupColor = PersistentData.PersistentContainer.Instance.Chatgroups.GetGroupColor(group);
                                groupColor = string.Format("[{0}]", groupColor);
                                chatName = PersistentData.PersistentContainer.Instance.Players[_cInfo.playerId, false].ChatNameOverride;
                                if (string.IsNullOrEmpty(chatName))
                                    chatName = _cInfo.playerName;

                                GameManager.Instance.GameMessageServer(_cInfo, EnumGameMessages.Chat, _message, groupColor + chatName + "[-]", false, "Coppis", false);

                                //Log.Out("Chat: '" + p.Name + "': " + _message);
                                return false;
                            }
                        }
                        
                        if (!string.IsNullOrEmpty(p.ChatColor))
                        {
                            chatName = PersistentData.PersistentContainer.Instance.Players[_cInfo.playerId, false].ChatNameOverride;
                            if (string.IsNullOrEmpty(chatName))
                                chatName = _cInfo.playerName;

                            if (p.ChatName)
                            {
                                GameManager.Instance.GameMessageServer(_cInfo, EnumGameMessages.Chat, _message, p.ChatColor + chatName + "[-]", false, "Coppis", false);
                            }
                            else
                            {
                                GameManager.Instance.GameMessageServer(_cInfo, EnumGameMessages.Chat, p.ChatColor + _message + "[-]", p.ChatColor + chatName + "[-]", false, "Coppis", false);
                            }

                            //Log.Out("Chatting colored: '" + p.Name + "': " + _message);
                            return false;
                        }
                        

                        //check for normal chat if chatname is overridden
                        
                        chatName = PersistentData.PersistentContainer.Instance.Players[_cInfo.playerId, false].ChatNameOverride;
                        if (!string.IsNullOrEmpty(chatName))
                        {
                            GameManager.Instance.GameMessageServer(_cInfo, EnumGameMessages.Chat, _message, chatName, false, "Coppis", false);
                            //Log.Out("Chat: '" + p.Name + "': " + _message);
                            return false;
                        }
                        
                    }
				} else {
//					Log.Error ("ChatFilter: Argument _cInfo null on message: {0}", _message);
				}
			}

			return true;
		}

	}
}
